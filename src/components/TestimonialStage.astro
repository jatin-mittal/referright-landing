---
export interface Testimonial {
	readonly name: string;
	readonly role?: string;
	readonly title?: string;
	readonly company?: string;
	readonly companyLogoUrl?: string;
	readonly companyLogoDarkUrl?: string;
	readonly review: string;
	readonly accent?: string;
	readonly photoUrl?: string;
	readonly linkedinUrl?: string;
}

interface Props {
	batches: readonly (readonly Testimonial[])[];
}

const { batches } = Astro.props;
const initialsFor = (name: string): string =>
	name.trim().split(/\s+/u).slice(0, 2).map((part) => part[0]?.toUpperCase() ?? '').join('');
---

<div
	class="stage"
	data-motion="testimonials"
	data-motion-state="paused"
	aria-label="RightRefer community feedback"
>
	{
		batches.map((batch, batchIndex) => (
			<div class:list={['lane', batchIndex % 2 === 1 && 'is-reverse']}>
				<div class="track" data-testimonial-track>
					{[...batch, ...batch].map((testimonial, cardIndex) => (
						<article
							class:list={['quote-card', 'glass', 'lift', `accent-${testimonial.accent ?? 'primary'}`]}
							aria-hidden={cardIndex >= batch.length ? 'true' : undefined}
						>
							<div class="quote-person">
								{testimonial.photoUrl ? (
									<img class="quote-avatar" src={testimonial.photoUrl} alt="" width="32" height="32" loading="lazy" />
								) : (
									<span class="quote-avatar" aria-hidden="true">{initialsFor(testimonial.name)}</span>
								)}
								<span class="quote-identity">
									<strong>{testimonial.name}</strong>
									{(testimonial.title || testimonial.company || testimonial.role) && (
										<small class="quote-meta">
											{(testimonial.title || testimonial.role) && <span class="quote-title">{testimonial.title ?? testimonial.role}{testimonial.company && ' · '}</span>}
											{testimonial.companyLogoUrl && (
												<img
													class:list={['quote-company-logo', testimonial.companyLogoDarkUrl && 'is-light']}
													src={testimonial.companyLogoUrl}
													alt=""
													width="16"
													height="16"
												/>
											)}
											{testimonial.companyLogoDarkUrl && (
												<img class="quote-company-logo is-dark" src={testimonial.companyLogoDarkUrl} alt="" width="16" height="16" />
											)}
											{testimonial.company && <span class="quote-company" title={testimonial.company}>{testimonial.company}</span>}
										</small>
									)}
								</span>
							</div>
							{testimonial.linkedinUrl && (
								<a
									class="quote-linkedin"
									href={testimonial.linkedinUrl}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`View ${testimonial.name}'s LinkedIn profile (opens in a new tab)`}
									tabindex={cardIndex >= batch.length ? -1 : undefined}
								>
									<img src="/linkedin-blue.png" width="18" height="18" alt="" aria-hidden="true" />
								</a>
							)}
							<blockquote>“{testimonial.review}”</blockquote>
						</article>
					))}
				</div>
			</div>
		))
	}
</div>

<script>
	import { motionGate } from '../lib/motion';

	/* The marquee only animates while it is on screen, and never for a visitor
	   who has asked for reduced motion. */
	const stage = document.querySelector<HTMLElement>('[data-motion="testimonials"]');
	if (stage) motionGate(stage);
</script>

<style>
	.stage {
		display: grid;
		gap: 0.75rem;
		overflow: hidden;
		/* Fade the ends so cards enter and leave rather than being cut off. */
		mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
	}

	.lane {
		overflow: hidden;
	}

	.track {
		display: flex;
		width: max-content;
		gap: 0.75rem;
		animation: drift-left 42s linear infinite;
		animation-play-state: paused;
		will-change: transform;
	}

	.lane.is-reverse .track {
		animation-name: drift-right;
	}

	.stage[data-motion-state='playing'] .track {
		animation-play-state: running;
	}

	.stage:hover .track,
	.stage:focus-within .track {
		animation-play-state: paused;
	}

	/* ---- Card ---- */

	.quote-card {
		position: relative;
		display: grid;
		width: 20rem;
		gap: 0.75rem;
		align-content: start;
		padding: 1.125rem 1.25rem;
		border: 1px solid rgb(var(--color-border));
		border-radius: var(--radius-2xl);
		background: rgb(var(--color-surface));
		box-shadow: var(--shadow-raised);
	}

	.quote-person {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
		padding-right: 1.75rem;
	}

	.quote-avatar {
		display: grid;
		width: 2rem;
		height: 2rem;
		flex: 0 0 auto;
		border-radius: 50%;
		background: rgb(var(--accent-soft));
		color: rgb(var(--accent-ink));
		font-size: 0.6875rem;
		font-weight: 700;
		object-fit: cover;
		place-items: center;
	}

	.quote-linkedin {
		position: absolute;
		top: 0.875rem;
		right: 0.875rem;
		display: grid;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		color: rgb(var(--color-muted));
		place-items: center;
		transition: color 150ms ease, background-color 150ms ease;
	}

	.quote-linkedin:hover,
	.quote-linkedin:focus-visible {
		background: rgb(var(--accent-soft));
		color: rgb(var(--accent-ink));
	}

	.quote-linkedin img {
		display: block;
	}

	.quote-identity {
		display: grid;
		min-width: 0;
	}

	.quote-identity strong {
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.quote-meta {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		overflow: hidden;
		color: rgb(var(--color-muted));
		font-size: 0.75rem;
		white-space: nowrap;
	}

	.quote-company-logo {
		width: 1rem;
		height: 1rem;
		flex: 0 0 auto;
		border-radius: 0.125rem;
		object-fit: contain;
	}

	.quote-company-logo[src$='ukg.svg'],
	.quote-company-logo[src$='ukg-dark.svg'] {
		width: 2rem;
	}

	.quote-company-logo.is-dark,
	:global(html[data-theme='dark']) .quote-company-logo.is-light {
		display: none;
	}

	:global(html[data-theme='dark']) .quote-company-logo.is-dark {
		display: block;
	}

	.quote-company {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	blockquote {
		margin: 0;
		color: rgb(var(--color-ink));
		font-family: var(--font-display);
		font-size: 1rem;
		letter-spacing: -0.015em;
		line-height: 1.35;
	}

	@keyframes drift-left {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(calc(-50% - 0.375rem));
		}
	}

	@keyframes drift-right {
		from {
			transform: translateX(calc(-50% - 0.375rem));
		}
		to {
			transform: translateX(0);
		}
	}

	@media (max-width: 30rem) {
		.quote-card {
			width: min(18rem, calc(100vw - 4rem));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.track {
			animation: none;
			transform: none;
		}

		.quote-card[aria-hidden='true'] {
			display: none;
		}
	}
</style>
