---
import SectionIntro from './SectionIntro.astro';

export interface FlowNote {
	label: string;
	tone?: 'orange' | 'blue' | 'neutral';
}

export interface FlowNode {
	title: string;
	copy: string;
	notes?: FlowNote[];
}

interface Props {
	id: string;
	eyebrow: string;
	title: string;
	copy: string;
	variant: 'candidate' | 'referrer' | 'company';
	nodes: FlowNode[];
}

const { id, eyebrow, title, copy, variant, nodes } = Astro.props;
---

<section class:list={['journey-section', `journey-${variant}`]} id={id} aria-labelledby={`${id}-title`}>
	<div class="section-shell">
		<SectionIntro
			eyebrow={eyebrow}
			title={title}
			copy={copy}
			headingId={`${id}-title`}
			align="left"
			class="reveal"
		/>

		<div
			class={`node-flow node-flow-${variant} reveal`}
			data-motion="flow"
			data-motion-state="idle"
			style={`--flow-count:${nodes.length};--flow-progress:0%`}
		>
			<div class="node-flow-track" aria-hidden="true">
				<span class="node-flow-track-fill"></span>
			</div>

			<ol>
				{
					nodes.map((node, index) => (
						<li
							class:list={['node-flow-node', index === 0 && 'is-active']}
							data-flow-node
							style={`--node-index:${index}`}
						>
							<div class="node-flow-marker">
								<span>{String(index + 1).padStart(2, '0')}</span>
								<i aria-hidden="true"></i>
							</div>
							<div class="node-flow-content">
								<h3>{node.title}</h3>
								<p>{node.copy}</p>
								{node.notes && (
									<div class="node-flow-notes">
										{node.notes.map((note) => (
											<span class={`flow-note flow-note-${note.tone ?? 'neutral'}`}>
												{note.label}
											</span>
										))}
									</div>
								)}
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>
