---
export interface InboxMessage {
	sender: string;
	company: string;
	role: string;
	jobId: string;
	subject: string;
	snippet: string;
	time: string;
	skills: string[];
	context: string;
	ctaHref: string;
}

interface Props {
	messages: InboxMessage[];
}

const { messages } = Astro.props;
---

<div
	class="inbox-demo"
	data-motion="inbox"
	data-phase="idle"
	data-active-message="0"
	aria-label="Animated matched job email demonstration"
>
	<div class="inbox-topbar" aria-hidden="true">
		<span class="inbox-menu">
			<i></i><i></i><i></i>
		</span>
		<span class="inbox-logo">
			<svg viewBox="0 0 28 22">
				<path d="m2 3 12 9L26 3v16H2V3Z"></path>
				<path d="m2 3 12 9L26 3"></path>
			</svg>
			<strong>Mail</strong>
		</span>
		<span class="inbox-search">Search mail</span>
		<span class="inbox-user">JM</span>
	</div>

	<div class="inbox-workspace">
		<aside class="inbox-sidebar" aria-hidden="true">
			<span class="compose-pill">+</span>
			<span class="sidebar-item is-active"></span>
			<span class="sidebar-item"></span>
			<span class="sidebar-item"></span>
			<span class="sidebar-item"></span>
		</aside>

		<div class="inbox-list">
			<div class="inbox-list-heading">
				<span>Primary</span>
				<small>3 new opportunities</small>
			</div>

			{
				messages.map((message, index) => (
					<div
						class:list={['mail-row', index === 0 && 'is-selected']}
						data-mail-row
						data-message-index={index}
					>
						<span class="mail-checkbox"></span>
						<span class="mail-star">☆</span>
						<strong>{message.sender}</strong>
						<span class="mail-row-copy">
							<b>{message.role}</b>
							<small>, {message.snippet}</small>
						</span>
						<time>{message.time}</time>
					</div>
				))
			}
		</div>

		<div class="mail-preview-stack">
			{
				messages.map((message, index) => (
					<article
						class:list={['mail-preview', index === 0 && 'is-active']}
						data-mail-preview
						data-message-index={index}
						aria-hidden={index === 0 ? 'false' : 'true'}
						inert={index === 0 ? undefined : true}
					>
						<div class="mail-actions" aria-hidden="true">
							<span>←</span><span>⌁</span><span>⋮</span>
						</div>
						<div class="mail-subject">
							<div>
								<p>{message.company} · Job opportunity</p>
								<h3>{message.subject}</h3>
							</div>
							<span class="strong-match">Strong match</span>
						</div>
						<div class="mail-sender">
							<span>{message.company.slice(0, 1)}</span>
							<div>
								<strong>{message.sender}</strong>
								<small>to you · {message.time}</small>
							</div>
						</div>
						<div class="mail-body-copy">
							<p>Hello,</p>
							<p>
								We found a <strong>{message.role}</strong> opening that aligns with your
								experience. The role is listed as <strong>{message.jobId}</strong>.
							</p>
						</div>
						<div class="match-context">
							<span class="match-context-icon" aria-hidden="true">R</span>
							<div>
								<small>Matched with your experience</small>
								<strong>{message.context}</strong>
								<div class="mail-skill-list">
									{message.skills.map((skill) => <span>{skill}</span>)}
								</div>
							</div>
						</div>
						<a class="button button-primary inbox-cta" href={message.ctaHref}>
							Get a referral
							<svg viewBox="0 0 16 16" aria-hidden="true">
								<path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
							</svg>
						</a>
					</article>
				))
			}
		</div>
	</div>
</div>
