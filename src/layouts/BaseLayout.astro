---
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const socialImage = new URL('/og-image.png', canonicalUrl);
const organizationUrl = new URL('/', canonicalUrl);
const organizationId = new URL('/#organization', canonicalUrl);
const organizationLogo = new URL('/rightrefer-logo.webp', canonicalUrl);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<meta name="googlebot" content="index, follow, max-image-preview:large" />
		<meta name="theme-color" content="#0b2638" />
		<meta name="color-scheme" content="light" />

		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="preload" as="image" href="/hero-hands-poster.webp" type="image/webp" fetchpriority="high" />
		<link rel="preload" href="/Louize.woff2" as="font" type="font/woff2" crossorigin />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="RightRefer" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />

		<title>{title}</title>

		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@graph': [
					{
						'@type': 'Organization',
						'@id': organizationId.href,
						name: 'RightRefer',
						url: organizationUrl.href,
						description,
						logo: {
							'@type': 'ImageObject',
							url: organizationLogo.href,
							width: 256,
							height: 248,
						},
					},
					{
						'@type': 'WebSite',
						'@id': new URL('/#website', canonicalUrl).href,
						name: 'RightRefer',
						url: organizationUrl.href,
						publisher: {
							'@id': organizationId.href,
						},
					},
				],
			})}
		/>
		<Analytics />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>
